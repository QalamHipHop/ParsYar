# =====================================================================
# ParsYar Enterprise — نمونهٔ تنظیمات محیطی
# این فایل را به .env کپی کنید و مقادیر را با محیط واقعی جایگزین کنید.
# هرگز .env را commit نکنید.
# =====================================================================

# === وردپرس (اگر wp-config.php از env استفاده می‌کند) =============
WP_HOME=https://example.com
WP_SITEURL=https://example.com
WP_DEBUG=false
WP_DEBUG_LOG=false
WP_DEBUG_DISPLAY=false
WP_ENV=production

# === دیتابیس =======================================================
DB_NAME=wordpress
DB_USER=wp_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_CHARSET=utf8mb4
DB_COLLATE=utf8mb4_persian_ci

# === کلیدهای امنیتی وردپرس (از https://api.wordpress.org/secret-key/1.1/salt/) ===
AUTH_KEY=put-random-here
AUTH_SALT=put-random-here
LOGGED_IN_KEY=put-random-here
LOGGED_IN_SALT=put-random-here
NONCE_KEY=put-random-here
NONCE_SALT=put-random-here
SECURE_AUTH_KEY=put-random-here
SECURE_AUTH_SALT=put-random-here

# === ParsYar Enterprise =============================================
# کلید API سامانهٔ مؤدیان (tax.gov.ir) — اختیاری، در غیر این صورت از sandbox استفاده می‌شود
MOODIAN_API_KEY=
MOODIAN_API_URL=https://api.tax.gov.ir/v1
MOODIAN_PRIVATE_KEY_PATH=/etc/parsyar/keys/moodian.pem

# کلید مخفی برای signing توکن‌های احراز هویت (HMAC). در production باید ≥ 64 کاراکتر باشد.
ENTERPRISE_AUTH_SECRET=generate-a-long-random-secret-at-least-64-chars-please

# غیرفعال‌سازی rate limit (فقط development)
ENTERPRISE_RATE_LIMIT_DISABLED=false

# Rate limit (تعداد درخواست در دقیقه به ازای IP)
ENTERPRISE_RATE_LIMIT_PER_MINUTE=60

# مسیر backup
ENTERPRISE_BACKUP_PATH=/var/backups/parsyar

# فعال‌سازی حالت دیباگ (لاگ‌های بیشتر)
ENTERPRISE_DEBUG=false

# === کش =============================================================
# اولویت: redis > memcached > transient
WP_REDIS_HOST=127.0.0.1
WP_REDIS_PORT=6379
WP_REDIS_PASSWORD=

# === درگاه‌های پرداخت (اختیاری) ===================================
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false

IDPAY_API_KEY=
IDPAY_SANDBOX=false

NEXTPAY_API_KEY=

SAMAN_MERCHANT_ID=
SAMAN_PASSWORD=

PASARGAD_MERCHANT_ID=
PASARGAD_TERMINAL_ID=

# === پیامک ==========================================================
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=10008663

# === ایمیل ==========================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME=ParsYar

# === هوش مصنوعی (اختیاری) =========================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# === Webhook امنیتی (برای ارسال خودکار backup و رویدادها) =========
ENTERPRISE_WEBHOOK_SECRET=
