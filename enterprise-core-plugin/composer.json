{
    "name": "parsyar/enterprise-core",
    "description": "ParsYar Enterprise Core — WordPress-native CRM/ERP/HCM platform with Persian-first design, double-entry accounting, and Iranian regulatory compliance (Māndian, Shaparak, Jibit, Iranian banks).",
    "type": "wordpress-plugin",
    "keywords": [
        "wordpress",
        "crm",
        "erp",
        "hcm",
        "persian",
        "farsi",
        "jalali",
        "iran",
        "moodian",
        "electronic-invoice",
        "double-entry",
        "ledger",
        "accounting"
    ],
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "ParsYar Team",
            "email": "dev@parsyar.local",
            "homepage": "https://parsyar.app"
        }
    ],
    "homepage": "https://parsyar.app",
    "support": {
        "issues": "https://github.com/QalamHipHop/ParsYar/issues",
        "source": "https://github.com/QalamHipHop/ParsYar"
    },
    "require": {
        "php": ">=8.1",
        "ext-mbstring": "*",
        "ext-intl": "*",
        "ext-mysqli": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-fileinfo": "*",
        "ext-ctype": "*",
        "ext-iconv": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.7",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "wp-coding-standards/wpcs": "^3.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "mockery/mockery": "^1.6",
        "brain/monkey": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "Enterprise\\": "includes/",
            "Enterprise\\Modules\\": "modules/",
            "Enterprise\\Api\\": "api/",
            "Enterprise\\Admin\\": "admin/",
            "Enterprise\\Db\\": "db/",
            "Enterprise\\Frontend\\": "frontend/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Enterprise\\Tests\\Unit\\": "tests/unit/",
            "Enterprise\\Tests\\Integration\\": "tests/integration/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=unit",
        "test:integration": "phpunit --testsuite=integration",
        "phpcs": "phpcs --standard=WordPress --extensions=php --ignore=vendor/ .",
        "phpcbf": "phpcbf --standard=WordPress --extensions=php --ignore=vendor/ ."
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
